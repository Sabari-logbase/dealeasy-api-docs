        "pages": ["index"]
      },
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/create-an-integration",
          "getting-started/authentication"
        ]
      },
      {
        "group": "Volume Discounts",
        "pages": [
          "volume-discounts/overview",
          "volume-discounts/get-volume-discounts",
          "volume-discounts/response"
        ]
      },
      {
        "group": "Errors",
        "pages": ["errors/error-codes"]
      },
      {
        "group": "Guides",
        "pages": ["guides/shopify-headless", "guides/shopify-custom-app"]
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
