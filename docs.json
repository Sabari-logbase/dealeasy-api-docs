{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dealeasy API",
  "description": "Read Dealeasy discount campaigns from headless storefronts and custom Shopify apps.",
  "colors": {
    "primary": "#0B7A55",
    "light": "#34D399",
    "dark": "#0B7A55"
  },
  "favicon": "/favicon.svg",
  "api": {
    "openapi": "openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "node"
      ]
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Introduction",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/create-an-integration",
          "getting-started/authentication"
        ]
      },
      {
        "group": "Campaigns",
        "pages": [
          "campaigns/overview",
          {
            "group": "Product campaigns",
            "expanded": true,
            "pages": [
              "campaigns/get-all-product-campaigns",
              "campaigns/get-campaigns-for-a-specific-product",
              "campaigns/volume-discount",
              "campaigns/bogo",
              "campaigns/gift-with-product"
            ]
          }
        ]
      },
      {
        "group": "Errors",
        "pages": [
          "errors/error-codes"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/shopify-headless",
          "guides/shopify-custom-app"
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
